{
  "expo": {
    "name": "yomico-app",
    "slug": "yomico-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yomico.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.yomico.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow YOMICO to access your photos so you can attach them to a review.",
          "cameraPermission": "Allow YOMICO to access your camera so you can take a photo for a review.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "./plugins/withBlockedPermissions"
    ],
    "extra": {
      "eas": {
        "projectId": "81dfbd60-2a67-45c5-b2ba-cb2e11041803"
      }
    },
    "owner": "piyuvisu"
  }
}
